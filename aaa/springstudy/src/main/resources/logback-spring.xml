<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 日志输出格式定义 -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{50} - %msg%n"/>
    <property name="LOG_FILE" value="logs/app.log"/>

    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 文件输出：纯按时间滚动（按天分割） -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 日志文件路径 -->
        <file>${LOG_FILE}</file>

        <!-- 滚动策略：纯时间滚动（TimeBasedRollingPolicy） -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 滚动文件名称格式：移除 %i 序号（纯按天分割，无需序号） -->
            <fileNamePattern>logs/app.log.%d{yyyy-MM-dd}.gz</fileNamePattern>
            <!-- 日志文件保留天数：7天（超过7天自动删除旧日志） -->
            <maxHistory>7</maxHistory>
            <!-- 可选：总日志文件大小上限（超出后删除最旧日志，按需配置） -->
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>

        <!-- 日志格式 -->
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 日志级别配置 -->
    <logger name="org.example.springstudy" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <logger name="org.example.springstudy.config.ApiRequestInterceptor" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- 根日志配置 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>