page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
}

.container {
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2d5016;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f7e6;
}

.status-indicator {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #dc3545;
  display: inline-block;
  margin-right: 12rpx;
}

.status-indicator.connected {
  background-color: #28a745;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.data-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f7e6;
}

.data-item:last-child {
  border-bottom: none;
}

.data-label {
  font-size: 28rpx;
  color: #666;
}

.data-value {
  font-size: 30rpx;
  font-weight: bold;
  color: #2d5016;
}

.btn {
  background-color: #2d5016;
  color: white;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
  margin: 16rpx 0;
}

.btn:active {
  opacity: 0.8;
}

.btn-warning {
  background-color: #dc3545;
}

.btn-primary {
  background-color: #007bff;
}

.btn-disabled {
  background-color: #ccc;
  color: #999;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.zone-card {
  background: white;
  border-radius: 12rpx;
  padding: 20rpx;
  border: 1rpx solid #e9ecef;
}

.zone-card h4 {
  font-size: 28rpx;
  font-weight: bold;
  color: #2d5016;
  margin-bottom: 12rpx;
}

.zone-card p {
  font-size: 24rpx;
  color: #666;
  margin: 6rpx 0;
}

.zone-active {
  color: #28a745;
}

.zone-warning {
  color: #ffc107;
}

.connection-status {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  font-size: 24rpx;
  color: #666;
}

.flex {
  display: flex;
  gap: 20rpx;
}

.flex-1 {
  flex: 1;
}