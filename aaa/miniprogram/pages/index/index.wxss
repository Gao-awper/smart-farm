.container {
  padding: 0;
  padding-bottom: 120rpx;
}

.header {
  position: relative;
  height: 320rpx;
  margin-bottom: 20rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: linear-gradient(135deg, #2d5016 0%, #4a7c23 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 60rpx 30rpx 30rpx;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.avatar-text {
  color: white;
  font-size: 36rpx;
  font-weight: bold;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.user-name {
  color: white;
  font-size: 32rpx;
  font-weight: bold;
}

.user-role {
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

.header-stats {
  display: flex;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #2d5016;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.quick-actions {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
}

.action-card {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 20rpx;
}

.action-card.no-margin {
  margin-right: 0;
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.monitoring-icon {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.irrigation-icon {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.device-icon {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

.scan-icon {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
}

.icon-text {
  font-size: 40rpx;
}

.action-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.action-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.card {
  margin: 0 20rpx 20rpx;
}

.card-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.more-link {
  font-size: 26rpx;
  color: #2d5016;
}

.sensor-summary {
  display: flex;
  justify-content: space-between;
}

.sensor-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
}

.sensor-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.sensor-value {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #2d5016;
}

.sensor-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.irrigation-summary {
  padding: 20rpx 0;
}

.irr-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.irr-label {
  font-size: 28rpx;
  color: #666;
}

.irr-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #6c757d;
}

.irr-value.active {
  color: #28a745;
}

.irr-info {
  padding-left: 20rpx;
  border-left: 4rpx solid #2d5016;
}

.irr-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.notification-list {
  padding-top: 10rpx;
}

.notification-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f7e6;
}

.notification-item:last-child {
  border-bottom: none;
}

.notification-dot {
  width: 12rpx;
  height: 12rpx;
  background: #dc3545;
  border-radius: 50%;
  margin-right: 20rpx;
}

.notification-content {
  flex: 1;
}

.notification-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.notification-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.notification-time {
  font-size: 22rpx;
  color: #ccc;
}
