<view class="container">
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="user-info">
        <view class="avatar">
          <text class="avatar-text">农</text>
        </view>
        <view class="user-detail">
          <text class="user-name">智慧农场管理员</text>
          <text class="user-role">高级管理员</text>
        </view>
      </view>
      <view class="header-stats">
        <view class="stat-item">
          <text class="stat-value">{{ headerStats.devices }}</text>
          <text class="stat-label">设备数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{ headerStats.normalRate }}%</text>
          <text class="stat-label">正常率</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{ headerStats.waterUsage }}吨</text>
          <text class="stat-label">今日用水</text>
        </view>
      </view>
    </view>
  </view>

  <view class="quick-actions">
    <view class="action-card" bindtap="goToMonitoring">
      <view class="action-icon monitoring-icon">
        <text class="icon-text">📊</text>
      </view>
      <text class="action-title">实时监测</text>
      <text class="action-desc">查看传感器数据</text>
    </view>
    <view class="action-card no-margin" bindtap="goToIrrigation">
      <view class="action-icon irrigation-icon">
        <text class="icon-text">💧</text>
      </view>
      <text class="action-title">智能灌溉</text>
      <text class="action-desc">控制灌溉系统</text>
    </view>
    <view class="action-card" bindtap="goToDevices">
      <view class="action-icon device-icon">
        <text class="icon-text">🔧</text>
      </view>
      <text class="action-title">设备管理</text>
      <text class="action-desc">查看设备状态</text>
    </view>
    <view class="action-card no-margin" bindtap="scanDevice">
      <view class="action-icon scan-icon">
        <text class="icon-text">📱</text>
      </view>
      <text class="action-title">扫码绑定</text>
      <text class="action-desc">绑定新设备</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">
      <text>实时数据概览</text>
      <text class="more-link" bindtap="goToMonitoring">查看详情</text>
    </view>
    <view class="sensor-summary">
      <view class="sensor-item">
        <text class="sensor-icon">🌡️</text>
        <view class="sensor-info">
          <text class="sensor-value">{{ sensorData.airTempDisplay }}°C</text>
          <text class="sensor-label">空气温度</text>
        </view>
      </view>
      <view class="sensor-item">
        <text class="sensor-icon">💧</text>
        <view class="sensor-info">
          <text class="sensor-value">{{ sensorData.soilMoistureDisplay }}%</text>
          <text class="sensor-label">土壤湿度</text>
        </view>
      </view>
      <view class="sensor-item">
        <text class="sensor-icon">☀️</text>
        <view class="sensor-info">
          <text class="sensor-value">{{ sensorData.lightDisplay }}klux</text>
          <text class="sensor-label">光照强度</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">
      <text>灌溉状态</text>
      <text class="more-link" bindtap="goToIrrigation">查看详情</text>
    </view>
    <view class="irrigation-summary">
      <view class="irr-status">
        <text class="irr-label">当前状态</text>
        <text class="irr-value {{ irrigationStatus.status === '运行中' ? 'active' : '' }}">
          {{ irrigationStatus.status }}
        </text>
      </view>
      <view class="irr-info">
        <text class="irr-text">上次灌溉: {{ irrigationStatus.lastIrrigation }}</text>
        <text class="irr-text">今日用水: {{ irrigationStatus.todayWaterUsage }}吨</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">系统通知</view>
    <view class="notification-list">
      <view class="notification-item">
        <view class="notification-dot"></view>
        <view class="notification-content">
          <text class="notification-title">设备告警</text>
          <text class="notification-desc">西区土壤湿度低于阈值，建议灌溉</text>
        </view>
        <text class="notification-time">5分钟前</text>
      </view>
      <view class="notification-item">
        <view class="notification-dot"></view>
        <view class="notification-content">
          <text class="notification-title">灌溉完成</text>
          <text class="notification-desc">东区灌溉任务已完成，用水量25吨</text>
        </view>
        <text class="notification-time">30分钟前</text>
      </view>
      <view class="notification-item">
        <view class="notification-dot"></view>
        <view class="notification-content">
          <text class="notification-title">系统更新</text>
          <text class="notification-desc">智慧农场系统已升级到v2.0版本</text>
        </view>
        <text class="notification-time">2小时前</text>
      </view>
    </view>
  </view>
</view>
