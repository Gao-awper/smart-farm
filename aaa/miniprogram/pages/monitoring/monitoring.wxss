.container {
  padding: 20rpx;
  padding-bottom: 120rpx;
}

.connection-status {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  font-size: 26rpx;
  color: #666;
}

.status-indicator {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #dc3545;
  margin-right: 12rpx;
}

.status-indicator.connected {
  background-color: #28a745;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2d5016;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f7e6;
}

.sensor-data {
  display: flex;
  flex-direction: column;
}

.data-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f7e6;
}

.data-item:last-child {
  border-bottom: none;
}

.data-label {
  font-size: 28rpx;
  color: #666;
}

.data-value-row {
  display: flex;
  align-items: baseline;
}

.data-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #2d5016;
}

.data-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

.chart-placeholder {
  padding: 20rpx 0;
}

.chart-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
  padding: 0 20rpx;
}

.chart-bar {
  width: 40rpx;
  border-radius: 8rpx 8rpx 0 0;
  transition: height 0.3s ease;
}

.chart-labels {
  display: flex;
  justify-content: space-between;
  padding: 0 20rpx;
  margin-top: 16rpx;
}

.chart-labels text {
  width: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #999;
}
