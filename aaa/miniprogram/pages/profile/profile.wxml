<view class="container">
  <view class="profile-header">
    <view class="avatar-section">
      <view class="avatar">
        <text class="avatar-text">农</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{ userInfo.name }}</text>
        <text class="user-role">{{ userInfo.role }}</text>
      </view>
    </view>
    <view class="edit-btn" bindtap="editProfile">
      <text>编辑资料</text>
    </view>
  </view>

  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-value">12</text>
      <text class="stat-label">管理设备</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">8</text>
      <text class="stat-label">监测地块</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">365</text>
      <text class="stat-label">运行天数</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">系统功能</view>
    <view class="function-list">
      <view class="function-item" bindtap="navigateTo" data-page="settings">
        <text class="function-icon">⚙️</text>
        <text class="function-name">系统设置</text>
        <text class="function-arrow">›</text>
      </view>
      <view class="function-item" bindtap="navigateTo" data-page="notification">
        <text class="function-icon">🔔</text>
        <text class="function-name">消息通知</text>
        <view class="function-badge">3</view>
        <text class="function-arrow">›</text>
      </view>
      <view class="function-item" bindtap="navigateTo" data-page="logs">
        <text class="function-icon">📋</text>
        <text class="function-name">操作日志</text>
        <text class="function-arrow">›</text>
      </view>
      <view class="function-item" bindtap="navigateTo" data-page="reports">
        <text class="function-icon">📊</text>
        <text class="function-name">数据报表</text>
        <text class="function-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">快捷操作</view>
    <view class="function-list">
      <view class="function-item" bindtap="exportData">
        <text class="function-icon">📤</text>
        <text class="function-name">导出数据</text>
        <text class="function-arrow">›</text>
      </view>
      <view class="function-item" bindtap="shareApp">
        <text class="function-icon">📱</text>
        <text class="function-name">分享应用</text>
        <text class="function-arrow">›</text>
      </view>
      <view class="function-item" bindtap="feedback">
        <text class="function-icon">💬</text>
        <text class="function-name">意见反馈</text>
        <text class="function-arrow">›</text>
      </view>
      <view class="function-item" bindtap="about">
        <text class="function-icon">ℹ️</text>
        <text class="function-name">关于我们</text>
        <text class="function-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">账户安全</view>
    <view class="function-list">
      <view class="function-item" bindtap="changePassword">
        <text class="function-icon">🔑</text>
        <text class="function-name">修改密码</text>
        <text class="function-arrow">›</text>
      </view>
      <view class="function-item" bindtap="bindingPhone">
        <text class="function-icon">📞</text>
        <text class="function-name">绑定手机</text>
        <text class="function-arrow">›</text>
      </view>
      <view class="function-item" bindtap="logout">
        <text class="function-icon">🚪</text>
        <text class="function-name logout">退出登录</text>
        <text class="function-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="version-info">
    <text>智慧农场管理系统 v2.0.0</text>
  </view>
</view>
